# Wajib: API key OpenAI disimpan di backend, bukan di extension.
OPENAI_API_KEY=sk-isi_api_key_openai_kamu

# Opsional: model default untuk explanation.
OPENAI_MODEL=gpt-4.1-mini

# Opsional: batasi model yang boleh diminta extension.
ALLOWED_MODELS=gpt-4.1-mini,gpt-4o-mini

# Opsional: token sederhana agar endpoint tidak terlalu terbuka.
# Kalau diisi, extension juga harus mengirim setting maintainabilityRiskAnalyzer.llm.proxyToken dengan nilai yang sama.
PROXY_ACCESS_TOKEN=

# Opsional: batas panjang snippet fungsi yang diteruskan ke OpenAI.
MAX_SNIPPET_CHARS=6000
